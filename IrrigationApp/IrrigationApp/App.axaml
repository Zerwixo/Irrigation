<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IrrigationApp"
             x:Class="IrrigationApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppTextColor">#0F172A</Color>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource AppTextColor}"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="{DynamicResource AppTextColor}"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{DynamicResource AppTextColor}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppTextColor">#F8FAFC</Color>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource AppTextColor}"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="{DynamicResource AppTextColor}"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{DynamicResource AppTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AppTextBrush" Color="{DynamicResource AppTextColor}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
    </Application.Styles>
</Application>