<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:IrrigationApp"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="IrrigationApp.Consomation">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12" MaxWidth="760" HorizontalAlignment="Center">
            <TextBlock TextAlignment="Center" FontSize="26" Text="Consomation" />

            <Border BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="6" Background="#FFF8FAFC">
                <StackPanel>
                    <Grid ColumnDefinitions="*,140" Margin="12,10,12,6">
                        <TextBlock Grid.Column="0" Text="Appareil" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Consomation (m3)" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="#D0D0D0" Margin="12,0" />

                    <ItemsControl x:Name="ConsomationItemsControl" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ConsomationRow">
                                <Grid ColumnDefinitions="*,140" Margin="12,0,12,6">
                                    <TextBlock Grid.Column="0" Text="{Binding Appareil}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Consomation}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#D0D0D0" Margin="12,2,12,0" />

                    <Grid ColumnDefinitions="*,140" Margin="12,8,12,10">
                        <TextBlock Grid.Column="0" Text="Total" FontWeight="SemiBold" />
                        <TextBlock x:Name="TotalConsomationText" Grid.Column="1" Text="0" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button HorizontalAlignment="Center" Click="RetourMenu" Content="Retour" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
