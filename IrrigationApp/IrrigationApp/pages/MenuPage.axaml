<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="IrrigationApp.MenuPage">

    <StackPanel Spacing="12">
        <TextBlock TextAlignment="Center" FontSize="26" Text="Menu principal" />
        <Button HorizontalAlignment="Center" Click="AjoutData" Content="Nouvelle saisie"/>
        <Button HorizontalAlignment="Center" Click="ModifData" Content="Modifier saisie"/>
        <Button HorizontalAlignment="Center" Click="VoirData" Content="Voir saisie"/>
        <Button HorizontalAlignment="Center" Click="CreationExcel" Content="Creer Excel"/>
        <Button HorizontalAlignment="Center" Click="QuitApplication" Content="Quitter l'application"/>
    </StackPanel>
</UserControl>


